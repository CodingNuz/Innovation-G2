# Copy to .env and fill in for the Assistant (chat) tab.
# Any OpenAI-compatible server works. Nothing is hard-coded in the source.
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=your-model-name
LLM_API_KEY=your-api-key

# Optional: seconds to wait for a chat completion (default 300).
# LLM_TIMEOUT=300
